# HTTP port (Cloud Run sets PORT itself)
PORT=8080

# Altegio public API
ALTEGIO_API_BASE=https://api.alteg.io/api/v1
# Partner API token of developer account 2630 "Altegio AI", shared with Altegio.Pro MCP (required). Production value lives in GCP Secret Manager.
ALTEGIO_API_TOKEN=your_partner_token_here
# Absolute path of the mounted partner token file (production); wins over ALTEGIO_API_TOKEN and is re-read lazily every 60 s, so a rotation needs no restart. Empty counts as unset.
ALTEGIO_API_TOKEN_FILE=

# Public URL of this server; its origin is the allowed browser Origin
PUBLIC_BASE_URL=http://localhost:8080

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# development | test | production (default production; keep development for local runs; the Docker image sets production)
NODE_ENV=development

# required | off (default required). Production keeps the default: POST /mcp is served only with a valid mcp-proxy signature. Local runs turn the check off.
PROXY_AUTH=off
# Shared key of the mcp-proxy signature (comma list for a rotation, each key at least 32 characters). Production mounts it as a file instead.
MCP_PROXY_BACKEND_KEY=
# Absolute path of the mounted key file; wins over MCP_PROXY_BACKEND_KEY. Re-read lazily every 60 s.
MCP_PROXY_BACKEND_KEY_FILE=
# required | optional (default required). Production keeps the default: every POST /mcp needs the caller's own Altegio partner token (Authorization: Bearer <token>, or the proxy's signed header), and upstream calls use it. optional serves callers without one with ALTEGIO_API_TOKEN; local runs use it so the inspector works without a token.
CALLER_AUTH=optional
# Header the proxy signs the client's Altegio user token into (must start with x-mcp-auth-). Default x-mcp-auth-altegio-user-token; change only if the platform's I8 header names differ. Empty counts as unset.
CLIENT_USER_TOKEN_HEADER=
# Header the proxy signs the client's scope list into (space-separated, must start with x-mcp-auth-). Default x-mcp-auth-scope; change only if the platform's I8 header names differ.
CLIENT_SCOPE_HEADER=
# Value of x-mcp-auth-kind that marks a client sign-in (not partner). Default client; change only if the platform's I8 names differ.
CLIENT_CALLER_KIND=
# Key of the confirmation tokens of the write tools (32 to 512 printable characters, no spaces). Unset: a per-process key, so a confirmation is valid only on the instance that issued it; set it to share confirmations across instances.
CONFIRMATION_SECRET=
# Commit of the deployed build (7 to 40 lowercase hex characters), reported by GET /health. Empty counts as unset.
COMMIT_SHA=

# Number of proxies between the caller and this server, counted from the right of X-Forwarded-For (used when the proxy does not sign x-mcp-auth-client-ip). 1 is the platform proxy; 0 means none. The leftmost entries are never used.
TRUSTED_PROXY_HOPS=1
# Comma-separated CIDRs whose addresses share one request budget instead of being limited per address (default: Anthropic's outbound range, used by every claude.ai user).
SHARED_EGRESS_CIDRS=160.79.104.0/21
# Comma-separated browser origins served in addition to the PUBLIC_BASE_URL origin (requests without an Origin header are always served).
EXTRA_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
# Most POST /mcp requests in flight at once; more get 429. Keep it below the Cloud Run concurrency of 80.
EDGE_MAX_INFLIGHT=60
# Most requests in flight at once from one address.
EDGE_MAX_INFLIGHT_PER_IP=6
# Per-address token bucket: burst size and refill per second.
EDGE_IP_BURST=40
EDGE_IP_REFILL_PER_SEC=3
# Shared-egress token bucket: burst size and refill per second.
EDGE_POOL_BURST=200
EDGE_POOL_REFILL_PER_SEC=20
# Most upstream calls one non-pool address may have queued in the request gate.
GATE_MAX_QUEUE_PER_KEY=8

# Live suite only (npm run test:live); the server never reads these:
# ALTEGIO_E2E_LOCATION_ID=722227
# ALTEGIO_E2E_USER=1
# The user token of a test client, obtained by hand as docs/research/signed-in-routes.md describes; the server never reads it.
# ALTEGIO_USER_TOKEN=your_user_token_here
