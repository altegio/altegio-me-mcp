# HTTP port (Cloud Run sets PORT itself)
PORT=8080

# Altegio public API
ALTEGIO_API_BASE=https://api.alteg.io/api/v1
# Partner API token of the Altegio.me MCP developer account (required). Production value lives in GCP Secret Manager.
ALTEGIO_API_TOKEN=your_partner_token_here

# Public URL of this server; its origin is the allowed browser Origin
PUBLIC_BASE_URL=http://localhost:8080

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# development | test | production (the Docker image sets production)
NODE_ENV=development
