{
  "name": "altegio-me-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Stateless HTTP MCP server for Altegio clients: discover businesses, browse availability and manage their own appointments with confirmed booking changes",
  "license": "MIT",
  "engines": {
    "node": "^24.22.2 || ^26.13.0",
    "npm": ">=12.2.2 <13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts | pino-pretty",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "loadtest": "tsx src/loadtest/run.ts",
    "test:live": "ALTEGIO_E2E=1 node --env-file=.env ./node_modules/jest/bin/jest.js --testPathPatterns=live --runInBand",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p scripts/browser-check/tsconfig.ci.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run build",
    "inventory:generate": "npm run build && node scripts/tool-inventory.mjs",
    "inventory:check": "node scripts/tool-inventory.mjs --check",
    "test:package": "node scripts/package-check.mjs",
    "typecheck:browser": "tsc -p scripts/browser-check/tsconfig.json"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7",
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "packageManager": "npm@12.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altegio/altegio-me-mcp.git"
  },
  "homepage": "https://github.com/altegio/altegio-me-mcp#readme",
  "bugs": {
    "url": "https://github.com/altegio/altegio-me-mcp/issues"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/prepare.mjs"
  ],
  "bin": {
    "altegio-me-mcp": "dist/server.js"
  },
  "exports": {
    "./package.json": "./package.json"
  }
}
