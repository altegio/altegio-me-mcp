{
  "name": "altegio-me-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server that lets clients of Altegio businesses discover services and free time slots from AI assistants and hand off to the booking widget",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts | pino-pretty",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "loadtest": "tsx src/loadtest/run.ts",
    "test:live": "ALTEGIO_E2E=1 node --env-file=.env ./node_modules/jest/bin/jest.js --testPathPatterns=live --runInBand",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p scripts/browser-check/tsconfig.ci.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "ajv": "^8.17.1",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
