# HTTP port (Cloud Run sets PORT itself)
PORT=8080

# Altegio public API
ALTEGIO_API_BASE=https://api.alteg.io/api/v1
# Partner API token of developer account 2630 "Altegio AI", shared with Altegio.Pro MCP (required). Production value lives in GCP Secret Manager.
ALTEGIO_API_TOKEN=your_partner_token_here
# Absolute path of the mounted partner token file (production); wins over ALTEGIO_API_TOKEN and is re-read lazily every 60 s, so a rotation needs no restart. Empty counts as unset.
ALTEGIO_API_TOKEN_FILE=

# Public URL of this server; its origin is the allowed browser Origin
PUBLIC_BASE_URL=http://localhost:8080

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# development | test | production (default production; keep development for local runs; the Docker image sets production)
NODE_ENV=development

# required | off (default required). Production keeps the default: POST /mcp is served only with a valid mcp-proxy signature. Local runs turn the check off.
PROXY_AUTH=off
# Shared key of the mcp-proxy signature (comma list for a rotation, each key at least 32 characters). Production mounts it as a file instead.
MCP_PROXY_BACKEND_KEY=
# Absolute path of the mounted key file; wins over MCP_PROXY_BACKEND_KEY. Re-read lazily every 60 s.
MCP_PROXY_BACKEND_KEY_FILE=
# Commit of the deployed build (7 to 40 lowercase hex characters), reported by GET /health. Empty counts as unset.
COMMIT_SHA=

# Live suite only (npm run test:live); the server never reads these:
# ALTEGIO_E2E_LOCATION_ID=722227
