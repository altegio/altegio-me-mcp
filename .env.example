# HTTP port (Cloud Run sets PORT itself)
PORT=8080

# Altegio public API
ALTEGIO_API_BASE=https://api.alteg.io/api/v1
# Partner token of the Altegio.me MCP developer account. Production value lives in GCP Secret Manager.
ALTEGIO_PARTNER_TOKEN=

# Public URL of this server, used in links and OAuth metadata
PUBLIC_BASE_URL=http://localhost:8080

LOG_LEVEL=info
